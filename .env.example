# Copy to .env.local (never commit .env.local). On Vercel, add the same keys under
# Settings → Environment Variables. See .ai-brain/DEPLOYMENT.md → "The contact form".

# Resend API key (resend.com → API Keys). Required for the contact form to send.
RESEND_API_KEY=

# Sender on a domain verified in Resend. Leave empty until kirtikadev.in is verified;
# Resend's onboarding@resend.dev is used meanwhile (it only delivers to the account owner).
CONTACT_FROM_EMAIL=

# Where enquiries go. Defaults to LINKS.email in lib/site.ts.
CONTACT_TO_EMAIL=
